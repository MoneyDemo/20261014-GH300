@page "{id:guid}"
@model EditModel
@{
    ViewData["Title"] = "編輯待辦事項";
}

<section class="edit-card card shadow-sm">
    <div class="card-body">
        <p class="eyebrow">調整你的計畫</p>
        <h1 class="h3 mb-4">編輯待辦事項</h1>
        <form method="post">
            <div class="mb-3">
                <label asp-for="EditTitle" class="form-label">事項內容</label>
                <input asp-for="EditTitle" class="form-control" maxlength="120" autofocus />
                <span asp-validation-for="EditTitle" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">儲存變更</button>
                <a asp-page="/Index" class="btn btn-outline-secondary">取消</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
